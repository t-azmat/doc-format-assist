.publish/
.cache/
.local/

# User data. These directories hold uploaded manuscripts and rendered exports —
# unpublished academic work belonging to real people. Only artifacts/api-server
# had a local ignore rule, so anything written to another storage root (e.g.
# artifacts/storage/, or a STORAGE_DIR override inside the repo) was one
# `git add -A` away from being committed. Match every storage root instead.
**/storage/uploads/*
**/storage/exports/*
!**/storage/uploads/.gitkeep
!**/storage/exports/.gitkeep

# Secrets
.env
.env.*
!.env.example
