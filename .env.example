# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Required ---------------------------------------------------------------
# Postgres connection string.
DATABASE_URL=postgres://paper:paper@localhost:5432/paper_formatter
# Docker Compose database password. Use a long, random URL-safe value before deploying.
POSTGRES_PASSWORD=paper

# --- Optional: features -----------------------------------------------------
# Enables the AI compliance check. Without it, /analyze returns a graceful 422
# and everything else works normally.
OPENAI_API_KEY=

# --- Optional: server -------------------------------------------------------
PORT=8080
HOST=127.0.0.1
NODE_ENV=development

# Where uploaded manuscripts and rendered exports are written. Point this at a
# mounted volume in production.
# STORAGE_DIR=/var/lib/paper-formatter/storage

# Directory holding the built frontend. Set automatically in the container;
# leave unset for local development, where Vite serves the frontend.
# WEB_ROOT=

# --- Optional: security -----------------------------------------------------
# Comma-separated origins allowed to call the API with credentials. Leave empty
# when the frontend is served from the same origin as the API (the container
# layout). In development it defaults to the Vite dev server.
CORS_ORIGINS=

# Number of reverse-proxy hops in front of this service. Required for correct
# client IPs (rate limiting) and secure cookies behind TLS termination. Leave
# unset when nothing proxies the app — trusting the header otherwise lets a
# client spoof its own IP.
# TRUST_PROXY=1

# Force the Secure flag on the session cookie. Defaults to on when
# NODE_ENV=production. Set to true behind a TLS proxy in other environments.
# COOKIE_SECURE=true

# Session lifetime in days.
SESSION_TTL_DAYS=30

# --- Optional: formatting engine --------------------------------------------
# Interpreter used for the Python engine. Falls back to ./.venv, then python3.
# PYTHON_BIN=

# Hard ceiling on a single extract/format/export subprocess (milliseconds).
PYTHON_TIMEOUT_MS=300000

# How many Python processes may run at once. Measured: a 1.8MB PDF peaks at
# ~2.1GB of RSS for ~70s. Two at once on a 16GB laptop that is also running an
# editor, a browser and Postgres is enough to exhaust memory and freeze the
# desktop, so the default is one. Raise it only on a box with memory to spare.
PYTHON_MAX_CONCURRENCY=1

# Threads torch may use for layout inference. Defaults to a quarter of the CPUs.
# Docling's own default is half of them, which saturates the machine and makes
# the UI stop responding while an upload is being processed.
# PYTHON_TORCH_THREADS=3

# --- Extraction quality vs. cost --------------------------------------------
# These trade accuracy on scanned input for not melting a laptop. The defaults
# assume papers exported from LaTeX or Word, which carry a real text layer.

# Optical character recognition. Off by default: it buys nothing on a text PDF
# and costs an extra model. Turn on only for genuinely scanned documents —
# extraction becomes much slower and needs considerably more memory.
# DOCLING_OCR=0

# Table structure recognition quality. Docling defaults to ACCURATE; this app
# uses FAST. Set to 1 for the slower, more precise model.
# DOCLING_ACCURATE_TABLES=0

# Rasterize figures out of PDFs, and at what scale. The previous 2.0 meant four
# times the pixels of the default for every image on the page.
# DOCLING_PICTURES=1
# DOCLING_IMAGE_SCALE=1.0

# Equation recognition. Off by default because it loads a further vision model,
# on the same memory argument as OCR above. With it on, equations come back as
# LaTeX and export as native, editable Word equations (OMML); with it off, a
# layout model reads a rendered equation as garbled inline text.
# DOCLING_FORMULAS=0

# Hard ceiling on a single document, in seconds. Unset means no Docling-level
# limit, leaving only the subprocess timeout below — which kills the process and
# yields nothing. This limit lets Docling stop and return what it finished.
# DOCLING_TIMEOUT_SEC=300

# How long a request waits for a free slot before returning 503 (milliseconds).
PYTHON_QUEUE_TIMEOUT_MS=30000
# Maximum waiting jobs; excess requests receive 503 immediately.
PYTHON_MAX_QUEUE=10

# Disable rate limiting. Intended for load tests, never for production.
# RATE_LIMIT_DISABLED=false
